  "state": {
    "local": {
      "scene": {
        "type": "string",
        "default": ""
      },
      "selected_id": {
        "type": "string",
        "nullable": true,
        "default": "box"
      },
      "character_id": {
        "type": "string",
        "nullable": true,
        "default": "humanoid"
      },
      "pose_joint": {
        "type": "string",
        "default": "upper_arm_r"
      },
      "prompt": {
        "type": "string",
        "default": "A man enters an old library. He stands by the counter."
      },
      "style_id": {
        "type": "string",
        "default": "pencil"
      },
      "beauty_path": {
        "type": "string",
        "default": ""
      },
      "mesh_prompt": {
        "type": "string",
        "default": "wooden crate"
      },
      "comic": {
        "type": "string",
        "default": ""
      },
      "comic_layout": {
        "type": "string",
        "default": "grid_2x2"
      },
      "comic_panel_count": {
        "type": "number",
        "default": 0
      },
      "frame_label": {
        "type": "string",
        "default": ""
      },
      "storyboard_summary": {
        "type": "string",
        "default": "0 frames"
      },
      "pack_summary": {
        "type": "string",
        "default": ""
      },
      "pose_open": {
        "type": "boolean",
        "default": false
      },
      "locks_open": {
        "type": "boolean",
        "default": false
      },
      "mesh_open": {
        "type": "boolean",
        "default": false
      },
      "comic_open": {
        "type": "boolean",
        "default": false
      },
      "storyboard_open": {
        "type": "boolean",
        "default": false
      },
      "packs_open": {
        "type": "boolean",
        "default": false
      },
      "project_open": {
        "type": "boolean",
        "default": true
      },
      "camera_open": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "bindings": [
    {
      "id": "project",
      "tool": "illustration.project.load",
      "target": "/yaml",
      "invalidate_on": []
    },
    {
      "id": "beauty",
      "tool": "illustration.document.load",
      "target": "/beauty_path",
      "invalidate_on": [
        "local.beauty_path"
      ]
    }
  ],
  "actions": [
    {
      "id": "save_project",
      "tool": "illustration.project.save",
      "input": {
        "yaml": "$local.scene"
      },
      "refresh_binds": [
        "illustration.project.load"
      ]
    },
    {
      "id": "load_project",
      "tool": "illustration.project.load",
      "input": {},
      "refresh_binds": [
        "illustration.project.load"
      ]
    },
    {
      "id": "compose_scene",
      "service": "scene.compose",
      "input": {
        "prompt": "$local.prompt"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_wave",
      "service": "scene.pose",
      "input": {
        "preset": "wave_right",
        "humanoid_root": "$local.character_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_look",
      "service": "scene.pose",
      "input": {
        "humanoid_root": "$local.character_id",
        "look_at": {
          "x": 0.0,
          "y": 0.8,
          "z": 0.0
        },
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_rest",
      "service": "scene.pose",
      "input": {
        "preset": "rest",
        "humanoid_root": "$local.character_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_sit",
      "service": "scene.pose",
      "input": {
        "preset": "sitting",
        "humanoid_root": "$local.character_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_point",
      "service": "scene.pose",
      "input": {
        "preset": "pointing",
        "humanoid_root": "$local.character_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_ik_reach",
      "service": "scene.pose",
      "input": {
        "humanoid_root": "$local.character_id",
        "ik": {
          "chain": "arm_r",
          "target": {
            "x": 0.9,
            "y": 1.35,
            "z": 0.45
          },
          "pole": {
            "x": 0.4,
            "y": 1.6,
            "z": 1.0
          }
        },
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_fk_joint",
      "service": "scene.pose",
      "input": {
        "humanoid_root": "$local.character_id",
        "joint": "$local.pose_joint",
        "axis": [
          0.0,
          0.0,
          1.0
        ],
        "angle_rad": 0.52,
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_undo",
      "service": "scene.pose",
      "input": {
        "undo": true,
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "stub_beauty",
      "service": "render.submit",
      "input": {
        "backend": "stub",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-stub.png",
        "scene_yaml": "$local.scene",
        "style": "$local.style_id",
        "r": 48,
        "g": 72,
        "b": 96
      },
      "refresh_binds": []
    },
    {
      "id": "cpu_beauty",
      "service": "render.submit",
      "input": {
        "backend": "cpu",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-cpu.png",
        "scene_yaml": "$local.scene",
        "style": "$local.style_id",
        "width": 320,
        "height": 240
      },
      "refresh_binds": []
    },
    {
      "id": "blender_beauty",
      "service": "render.submit",
      "input": {
        "backend": "blender",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-blender.png",
        "scene_yaml": "$local.scene",
        "style": "$local.style_id",
        "width": 256,
        "height": 192
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_box",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "prop.box",
        "parent_id": "root",
        "prefix": "box_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_humanoid",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "humanoid.placeholder",
        "parent_id": "root",
        "prefix": "h_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_slim",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "humanoid.slim",
        "parent_id": "root",
        "prefix": "slim_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_cat",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "quadruped.cat",
        "parent_id": "root",
        "prefix": "cat_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "lock_selected",
      "service": "scene.lock",
      "input": {
        "id": "$local.selected_id",
        "scope": "node",
        "kind": "semantic",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "lock_subtree",
      "service": "scene.lock",
      "input": {
        "id": "$local.selected_id",
        "scope": "subtree",
        "kind": "semantic",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "unlock_selected",
      "service": "scene.unlock",
      "input": {
        "id": "$local.selected_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "mesh_assist_stub",
      "service": "mesh.assist",
      "input": {
        "prompt": "$local.mesh_prompt",
        "backend": "stub",
        "parent_id": "root",
        "prefix": "mesh_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "comic_layout",
      "service": "comic.layout",
      "input": {
        "template": "$local.comic_layout",
        "scene_yaml": "$local.scene",
        "width": 640,
        "height": 960
      },
      "refresh_binds": []
    },
    {
      "id": "comic_bind_panel",
      "service": "comic.layout",
      "input": {
        "comic_yaml": "$local.comic",
        "page_id": "page_1",
        "panel_id": "panel_1",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "comic_render",
      "service": "comic.render",
      "input": {
        "comic_yaml": "$local.comic",
        "page_id": "page_1",
        "backend": "cpu",
        "path": "/documents/illustrations/comic-page.png",
        "width": 640,
        "height": 960
      },
      "refresh_binds": []
    },
    {
      "id": "storyboard_capture",
      "service": "storyboard.capture",
      "input": {
        "scene_yaml": "$local.scene",
        "label": "$local.frame_label"
      },
      "refresh_binds": []
    },
    {
      "id": "storyboard_prev",
      "service": "storyboard.apply",
      "input": {
        "scene_yaml": "$local.scene",
        "direction": "prev"
      },
      "refresh_binds": []
    },
    {
      "id": "storyboard_next",
      "service": "storyboard.apply",
      "input": {
        "scene_yaml": "$local.scene",
        "direction": "next"
      },
      "refresh_binds": []
    },
    {
      "id": "storyboard_delete",
      "service": "storyboard.delete",
      "input": {
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "storyboard_move_earlier",
      "service": "storyboard.move",
      "input": {
        "scene_yaml": "$local.scene",
        "direction": "earlier"
      },
      "refresh_binds": []
    },
    {
      "id": "storyboard_move_later",
      "service": "storyboard.move",
      "input": {
        "scene_yaml": "$local.scene",
        "direction": "later"
      },
      "refresh_binds": []
    },
    {
      "id": "list_local_packs",
      "service": "asset.pack.list",
      "input": {
        "lang": "en"
      },
      "refresh_binds": []
    },
    {
      "id": "describe_primitives_pack",
      "service": "asset.pack.describe",
      "input": {
        "pack_id": "illustration-primitives-v0",
        "lang": "en"
      },
      "refresh_binds": []
    }
  ],
  "subscriptions": [],
  "root": {
    "kind": "split",
    "split_ratio": 0.3,
    "children": [
      {
        "kind": "scroll",
        "children": [
          {
            "kind": "text",
            "label_key": "tip_body"
          },
          {
            "kind": "text",
            "label_key": "scene_empty",
            "visible": {
              "eq": [
                "$local.scene",
                ""
              ]
            }
          },
          {
            "kind": "section",
            "label_key": "compose_section",
            "children": [
              {
                "kind": "text_input",
                "state_key": "prompt",
                "label_key": "prompt_label"
              },
              {
                "kind": "button",
                "label_key": "compose_label",
                "action": "compose_scene",
                "primary": true
              }
            ]
          },
          {
            "kind": "section",
            "label_key": "edit_section",
            "children": [
              {
                "kind": "section",
                "label_key": "assets_section",
                "children": [
                  {
                    "kind": "row",
                    "children": [
                      {
                        "kind": "button",
                        "label_key": "add_humanoid_label",
                        "action": "instantiate_humanoid"
                      },
                      {
                        "kind": "button",
                        "label_key": "add_slim_label",
                        "action": "instantiate_slim"
                      },
                      {
                        "kind": "button",
                        "label_key": "add_cat_label",
                        "action": "instantiate_cat"
                      },
                      {
                        "kind": "button",
                        "label_key": "add_box_label",
                        "action": "instantiate_box"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "section",
                "label_key": "camera_section",
                "children": [
                  {
                    "kind": "text",
                    "label_key": "camera_orbit_hint"
                  },
                  {
                    "kind": "text",
                    "label_key": "camera_controls_strip"
                  },
                  {
                    "kind": "text",
                    "label_key": "camera_look_hint"
                  },
                  {
                    "kind": "text",
                    "label_key": "camera_fov_hint"
                  }
                ],
                "collapsible": true,
                "open_state_key": "camera_open"
              }
            ]
          },
          {
            "kind": "section",
            "label_key": "render_section",
            "children": [
              {
                "kind": "radio",
                "state_key": "style_id",
                "label_key": "style_label",
                "inline": true,
                "items": [
                  "sketch",
                  "pencil",
                  "ink"
                ],
                "item_label_keys": [
                  "style_sketch",
                  "style_pencil",
                  "style_ink"
                ]
              },
              {
                "kind": "row",
                "children": [
                  {
                    "kind": "button",
                    "label_key": "cpu_render_label",
                    "action": "cpu_beauty",
                    "primary": true
                  },
                  {
                    "kind": "button",
                    "label_key": "stub_render_label",
                    "action": "stub_beauty"
                  },
                  {
                    "kind": "button",
                    "label_key": "blender_render_label",
                    "action": "blender_beauty"
                  }
                ]
              }
            ]
          },
          {
            "kind": "section",
            "label_key": "pose_section",
            "children": [
              {
                "kind": "row",
                "children": [
                  {
                    "kind": "button",
                    "label_key": "pose_wave_label",
                    "action": "pose_wave",
                    "primary": true
                  },
                  {
