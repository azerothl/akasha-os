{
  "type": "declarative_ui",
  "contract": 2,
  "title": "Illustration Studio",
  "title_key": "app_title",
  "labels": {
    "fallback": "en",
    "en": {
      "app_title": "Illustration Studio",
      "viewport_label": "Viewport",
      "scene_label": "Scene",
      "save_label": "Save project",
      "load_label": "Load project",
      "stub_render_label": "Stub beauty",
      "cpu_render_label": "CPU beauty",
      "add_humanoid_label": "Add humanoid",
      "about_body": "Product suite: SceneGraph + RenderService (stub/CPU) + primitives pack. Offline, no Blender.",
      "beauty_empty": "No beauty pass yet",
      "preview_label": "Beauty pass"
    },
    "fr": {
      "app_title": "Studio Illustration",
      "viewport_label": "Fenêtre 3D",
      "scene_label": "Scène",
      "save_label": "Enregistrer le projet",
      "load_label": "Charger le projet",
      "stub_render_label": "Beauté stub",
      "cpu_render_label": "Beauté CPU",
      "add_humanoid_label": "Ajouter humanoïde",
      "about_body": "Suite produit : SceneGraph + RenderService (stub/CPU) + pack primitives. Hors-ligne, sans Blender.",
      "beauty_empty": "Pas encore de rendu beauté",
      "preview_label": "Rendu beauté"
    }
  },
  "state": {
    "local": {
      "scene": { "type": "string", "default": "" },
      "selected_id": { "type": "string", "nullable": true, "default": "box" },
      "beauty_path": { "type": "string", "default": "" }
    }
  },
  "bindings": [
    {
      "id": "project",
      "tool": "illustration.project.load",
      "target": "/yaml",
      "invalidate_on": []
    },
    {
      "id": "beauty",
      "tool": "illustration.document.load",
      "target": "/beauty_path",
      "invalidate_on": ["local.beauty_path"]
    }
  ],
  "actions": [
    {
      "id": "save_project",
      "tool": "illustration.project.save",
      "input": { "yaml": "$local.scene" },
      "refresh_binds": ["illustration.project.load"]
    },
    {
      "id": "load_project",
      "tool": "illustration.project.load",
      "input": {},
      "refresh_binds": ["illustration.project.load"]
    },
    {
      "id": "stub_beauty",
      "service": "render.submit",
      "input": {
        "backend": "stub",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-stub.png",
        "scene_yaml": "$local.scene",
        "r": 48,
        "g": 72,
        "b": 96
      },
      "refresh_binds": []
    },
    {
      "id": "cpu_beauty",
      "service": "render.submit",
      "input": {
        "backend": "cpu",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-cpu.png",
        "scene_yaml": "$local.scene",
        "width": 256,
        "height": 192
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_humanoid",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "humanoid.placeholder",
        "parent_id": "root",
        "prefix": "h_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    }
  ],
  "subscriptions": [],
  "root": {
    "kind": "column",
    "children": [
      {
        "kind": "text",
        "label_key": "about_body"
      },
      {
        "kind": "row",
        "children": [
          {
            "kind": "button",
            "label_key": "save_label",
            "action": "save_project"
          },
          {
            "kind": "button",
            "label_key": "load_label",
            "action": "load_project"
          },
          {
            "kind": "button",
            "label_key": "stub_render_label",
            "action": "stub_beauty"
          },
          {
            "kind": "button",
            "label_key": "cpu_render_label",
            "action": "cpu_beauty"
          },
          {
            "kind": "button",
            "label_key": "add_humanoid_label",
            "action": "instantiate_humanoid"
          }
        ]
      },
      {
        "kind": "split",
        "split_ratio": 0.28,
        "children": [
          {
            "kind": "scroll",
            "children": [
              {
                "kind": "scene_tree",
                "scene_key": "scene",
                "selected_key": "selected_id",
                "canvas_id": "illustration_viewport",
                "label_key": "scene_label"
              }
            ]
          },
          {
            "kind": "column",
            "children": [
              {
                "kind": "scene3d",
                "scene_key": "scene",
                "selected_key": "selected_id",
                "canvas_id": "illustration_viewport",
                "label_key": "viewport_label"
              },
              {
                "kind": "image_view",
                "resource": "$local.beauty_path",
                "label_key": "preview_label",
                "empty_label_key": "beauty_empty"
              }
            ]
          }
        ]
      }
    ]
  }
}
