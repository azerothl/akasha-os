# Example MCP servers for Akasha OS Preview.
# Copy to var/mcp/servers.yaml (done automatically on first run if missing).
#
# Secrets: use ${secret:name} so API keys stay in the encrypted vault
# (Settings → Secrets), never plaintext in this file.
#
# Native web.browse is HTML→text with no JavaScript. For SPAs / hydrated
# pages, add a headless-browser MCP you installed yourself. That process
# does its own network egress — Akasha net.connect / offline_strict do not
# wrap it. Prefer native web.search / web.browse / net.fetch for ordinary HTML.
#
# Coding CLIs (Codex, Claude Code, Grok):
# - One-shot from a native agent: enable tool `harness.run` (Agents → External CLIs).
# - Full worker backend with Steer/Pause/Kill: Agents → Advanced → Runtime =
#   Codex / Claude / Grok (sets AgentSpec.execution_backend). Do not add a
#   generic shell MCP here — Akasha will not wrap arbitrary argv.
# - Details (PATH, fixed argv, cwd): docs/harness.md
#
# Reverse direction (IDE → Akasha): use bin/aos-mcpd as an MCP *server* in
# Claude Code / Codex / Cursor / Copilot. See docs/mcp-server.md and
# share/mcp/akasha-mcp.example.json. Not configured in this file.
#
# servers:
#   filesystem:
#     command: npx
#     args: ["-y", "@modelcontextprotocol/server-filesystem", "E:/docs"]
#     env: {}
#   github:
#     command: npx
#     args: ["-y", "@modelcontextprotocol/server-github"]
#     env:
#       GITHUB_PERSONAL_ACCESS_TOKEN: "${secret:github_token}"
#   browser:
#     command: obscura
#     args: ["mcp"]
#   # or: npx -y @playwright/mcp

servers: {}
