          "end_image": "$local.end_image",
          "flow_shift": "$local.flow_shift"
        }
      },
      "refresh_binds": ["create.result.get", "create.history.list"]
    },
    {
      "id": "save_preset",
      "tool": "create.preset.save",
      "input": {
        "name": "$local.saved_preset_name",
        "params": {
          "prompt": "$local.prompt", "negative_prompt": "$local.negative_prompt", "media_mode": "$local.media_mode", "model_id": "$local.model_id",
          "format": "$local.format", "intent": "$local.intent", "profile": "$local.profile", "camera_preset": "$local.camera_preset",
          "width": "$local.width", "height": "$local.height", "steps": "$local.steps", "video_frames": "$local.video_frames", "fps": "$local.fps",
          "cfg_scale": "$local.cfg_scale", "seed": "$local.seed", "sampling_method": "$local.sampling_method", "flow_shift": "$local.flow_shift",
          "styles": "$local.styles", "loras": "$local.loras", "vae": "$local.vae", "init_image": "$local.init_image", "end_image": "$local.end_image", "strength": "$local.strength", "mask_image": "$local.mask_image",
          "enrich_prompt": "$local.enrich_prompt", "enhance_prompt_chat": "$local.enhance_prompt_chat", "enriched_prompt": "$local.enriched_prompt",
          "composition_layers": "$local.composition_layers"
        }
      }
    },
    {
      "id": "load_preset",
      "tool": "create.preset.load",
      "input": { "name": "$local.saved_preset_name" }
    },
    {
      "id": "save_result",
      "service": "files.save_as",
      "input": { "source_path": "$local.result_path" }
    }
  ],
  "subscriptions": [
    { "id": "generate_job", "action": "generate_image", "kind": "media.image.generate" },
    { "id": "generate_video_job", "action": "generate_video", "kind": "media.image.generate" }
  ],
  "root": {
    "kind": "split",
    "split_ratio": 0.48,
    "children": [
      {
        "kind": "scroll",
        "children": [
          {
            "kind": "tabs",
            "label_key": "create-tabs",
            "tabs": [
              {
                "label_key": "tab_params",
                "content": {
                  "kind": "column",
                  "children": [
                    {
                      "kind": "section",
                      "label_key": "prompt_section",
                      "children": [
                        { "kind": "radio", "state_key": "media_mode", "items": ["image", "video"], "item_label_keys": ["mode_image", "mode_video"], "inline": true },
                        { "kind": "select", "state_key": "model_id", "binding": "models", "items_from_key": "$local.media_mode", "label_key": "image_pack_label", "tooltip_key": "tip_model", "visible": { "eq": ["$local.media_mode", "image"] } },
                        { "kind": "select", "state_key": "model_id", "binding": "models", "items_from_key": "$local.media_mode", "label_key": "video_pack_label", "tooltip_key": "tip_model", "visible": { "eq": ["$local.media_mode", "video"] } },
                        { "kind": "textarea", "state_key": "prompt", "label_key": "prompt_label", "tooltip_key": "tip_prompt" },
                        { "kind": "prompt_starters", "state_key": "prompt", "label_key": "starter_label", "items": ["A cinematic portrait with soft natural light", "A product photo on a clean studio background", "An atmospheric landscape at golden hour"] },
                        { "kind": "file_picker", "state_key": "init_image", "label_key": "reference_label" },
                        { "kind": "file_picker", "state_key": "end_image", "label_key": "end_reference_label", "visible": { "eq": ["$local.media_mode", "video"] } },
                        { "kind": "number", "state_key": "strength", "min": 0.05, "max": 1, "step": 0.05, "label_key": "reference_strength_label", "visible": { "ne": ["$local.init_image", ""] } },
                        { "kind": "textarea", "state_key": "negative_prompt", "label_key": "negative_label" }
                        ,{ "kind": "section", "label_key": "enrichment_section", "children": [
                          { "kind": "checkbox", "state_key": "enrich_prompt", "label_key": "enrich_prompt_label", "tooltip_key": "tip_prompt" },
                          { "kind": "checkbox", "state_key": "enhance_prompt_chat", "label_key": "enhance_prompt_label", "tooltip_key": "tip_prompt" },
                          { "kind": "checkbox", "state_key": "use_edited_enriched", "label_key": "edited_prompt_label", "visible": { "ne": ["$local.enriched_prompt", ""] } },
                          { "kind": "textarea", "state_key": "enriched_prompt", "label_key": "enriched_prompt_label", "visible": { "or": [{ "eq": ["$local.enrich_prompt", true] }, { "eq": ["$local.enhance_prompt_chat", true] }, { "eq": ["$local.use_edited_enriched", true] }] } }
                        ] }
                      ]
                    },
                    {
                      "kind": "section",
                      "label_key": "advanced_section",
                      "children": [
                        { "kind": "text_input", "state_key": "saved_preset_name", "label_key": "preset_name_label" },
                        { "kind": "row", "children": [
                          { "kind": "button", "action": "save_preset", "label_key": "save_preset_label", "enabled": { "ne": ["$local.saved_preset_name", ""] } },
                          { "kind": "button", "action": "load_preset", "label_key": "load_preset_label", "enabled": { "ne": ["$local.saved_preset_name", ""] } }
                        ] },
                        { "kind": "select", "state_key": "format", "items": ["1:1", "16:9", "9:16"], "label_key": "format_label" },
                        { "kind": "select", "state_key": "intent", "items": ["custom", "portrait", "product", "illustration", "cinematic"], "label_key": "intent_label" },
                        { "kind": "select", "state_key": "profile", "items": ["fast", "balanced", "quality"], "label_key": "quality_label" },
                        { "kind": "slider", "state_key": "width", "min": 256, "max": 1024, "step": 64, "label_key": "width_label" },
                        { "kind": "slider", "state_key": "height", "min": 256, "max": 1024, "step": 64, "label_key": "height_label" },
                        { "kind": "slider", "state_key": "steps", "min": 4, "max": 40, "step": 1, "label_key": "steps_label" },
                        { "kind": "number", "state_key": "video_frames", "min": 1, "max": 121, "label_key": "video_frames_label", "visible": { "eq": ["$local.media_mode", "video"] } },
                        { "kind": "number", "state_key": "fps", "min": 1, "max": 120, "label_key": "fps_label", "visible": { "eq": ["$local.media_mode", "video"] } },
                        { "kind": "select", "state_key": "camera_preset", "items": ["custom", "static", "push", "track", "follow"], "label_key": "camera_label", "visible": { "eq": ["$local.media_mode", "video"] } },
                        { "kind": "checkbox", "state_key": "img2img_enabled", "label_key": "img2img_label" },
                        { "kind": "file_picker", "state_key": "mask_image", "label_key": "inpaint_label", "visible": { "eq": ["$local.img2img_enabled", true] } },
                        { "kind": "section", "label_key": "styles_section", "children": [
                        { "kind": "multiselect", "state_key": "styles", "binding": "models", "source": "/assets/styles", "items": [], "label_key": "styles_label", "tooltip_key": "tip_styles" },
                          { "kind": "multiselect", "state_key": "loras", "binding": "models", "source": "/assets/loras", "items": [], "label_key": "loras_label", "tooltip_key": "tip_loras" },
                          { "kind": "select", "state_key": "vae", "binding": "models", "items_from_key": "$local.asset_binding_key", "source": "/vaes", "items": [], "label_key": "vae_label", "tooltip_key": "tip_vae" }
                          ,{ "kind": "asset_import", "state_key": "asset_import_kind", "source": "$local.asset_import_path", "binding": "$local.asset_import_status", "label_key": "import_assets_label" }
                        ] },
                        { "kind": "checkbox", "state_key": "expert", "label_key": "expert_label" }
                      ]
                    },
                    {
                      "kind": "section",
                      "label_key": "sampling_section",
                      "visible": { "eq": ["$local.expert", true] },
                      "children": [
                        { "kind": "number", "state_key": "cfg_scale", "min": 1, "max": 30, "step": 0.5, "label_key": "cfg_label" },
                        { "kind": "number", "state_key": "seed", "min": -1, "max": 2147483647, "label_key": "seed_label" },
                        { "kind": "select", "state_key": "sampling_method", "items": ["", "euler", "euler_a", "heun", "dpm2", "lcm", "ddim"], "label_key": "sampler_label" },
                        { "kind": "number", "state_key": "flow_shift", "min": 0, "max": 10, "step": 0.1, "label_key": "flow_shift_label", "visible": { "eq": ["$local.media_mode", "video"] } }
                        ,{ "kind": "section", "label_key": "expert_section", "children": [
                          { "kind": "checkbox", "state_key": "offload_to_cpu", "label_key": "offload_label" },
                          { "kind": "checkbox", "state_key": "diffusion_fa", "label_key": "diffusion_fa_label" },
                          { "kind": "checkbox", "state_key": "auto_fit", "label_key": "auto_fit_label" },
                          { "kind": "checkbox", "state_key": "stream_layers", "label_key": "stream_layers_label" },
                          { "kind": "text_input", "state_key": "max_vram", "label_key": "max_vram_label" },
                          { "kind": "number", "state_key": "threads", "min": 0, "max": 64, "label_key": "threads_label" },
                          { "kind": "select", "state_key": "backend", "items": ["", "cpu", "gpu", "cuda0", "vulkan0"], "label_key": "backend_label" },
                          { "kind": "select", "state_key": "params_backend", "items": ["", "cpu", "cuda0", "disk"], "label_key": "params_backend_label" }
                        ] }
                      ]
                    },
                    {
                      "kind": "row",
                      "children": [
                        { "kind": "button", "action": "generate_image", "label_key": "generate_image_label", "visible": { "eq": ["$local.media_mode", "image"] }, "enabled": { "and": [{ "eq": ["$local.model_ready", true] }, { "ne": ["$local.prompt", ""] }] } },
                        { "kind": "button", "action": "generate_video", "label_key": "generate_video_label", "visible": { "eq": ["$local.media_mode", "video"] }, "enabled": { "and": [{ "eq": ["$local.model_ready", true] }, { "ne": ["$local.prompt", ""] }] } }
                      ]
                    },
                    { "kind": "job", "subscription": "generate_job", "label_key": "job_label", "visible": { "eq": ["$local.media_mode", "image"] } },
                    { "kind": "job", "subscription": "generate_video_job", "label_key": "job_label", "visible": { "eq": ["$local.media_mode", "video"] } }
                  ]
                }
              },
              {
                "label_key": "tab_history",
                "content": {
                  "kind": "column",
                  "children": [
                    { "kind": "empty_state", "bind": "create.history.list", "source": "items", "label_key": "history_empty" },
                    { "kind": "table", "bind": "create.history.list", "source": "items", "columns": ["summary", "when"], "column_label_keys": ["history_prompt", "history_when"], "row_actions": [{ "tool": "create.history.get", "label_key": "history_restore", "args": { "id": "$row.id" }, "refresh_binds": ["create.result.get"] }] }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "kind": "column",
        "children": [
          { "kind": "layer_canvas", "binding": "preview", "state_key": "layer_opacity", "canvas_id": "create-composition", "layers_key": "composition_layers", "selected_key": "composition_selected", "aspect_w_key": "width", "aspect_h_key": "height", "aspect_w": 16, "aspect_h": 9, "tooltip_key": "tip_layers" },
          { "kind": "layer_list", "layers_key": "composition_layers", "selected_key": "composition_selected", "next_id_key": "composition_next_id", "label_key": "layers_list_label" },
          { "kind": "row", "children": [
            { "kind": "button", "action": "clear_preview", "label_key": "clear_preview_label", "enabled": { "ne": ["$local.result_path", ""] } },
            { "kind": "button", "action": "clear_layers", "label_key": "clear_layers_label" }
          ] },
          {
            "kind": "section",
            "label_key": "upscale_section",
            "children": [
              { "kind": "text_input", "state_key": "upscale_model", "label_key": "upscale_model_label" },
              { "kind": "number", "state_key": "upscale_repeats", "min": 1, "max": 4, "label_key": "upscale_repeats_label" },
              { "kind": "number", "state_key": "upscale_tile_size", "min": 32, "max": 512, "label_key": "upscale_tile_label" },
              { "kind": "button", "action": "upscale", "label_key": "upscale_label", "enabled": { "and": [{ "ne": ["$local.result_path", ""] }, { "ne": ["$local.upscale_model", ""] }] } }
            ]
          },
          { "kind": "row", "children": [
            { "kind": "button", "action": "save_result", "label_key": "save_label", "enabled": { "ne": ["$local.result_path", ""] } },
            { "kind": "button", "action": "regenerate", "label_key": "regenerate_label", "visible": { "eq": ["$local.media_mode", "image"] }, "enabled": { "ne": ["$local.result_path", ""] } },
            { "kind": "button", "action": "variant", "label_key": "variant_label", "visible": { "eq": ["$local.media_mode", "image"] }, "enabled": { "ne": ["$local.result_path", ""] } },
            { "kind": "button", "action": "regenerate_video", "label_key": "regenerate_label", "visible": { "eq": ["$local.media_mode", "video"] }, "enabled": { "ne": ["$local.result_path", ""] } },
            { "kind": "button", "action": "variant_video", "label_key": "variant_label", "visible": { "eq": ["$local.media_mode", "video"] }, "enabled": { "ne": ["$local.result_path", ""] } }
          ] }
        ]
      }
    ]
  }
}
