{
  "type": "declarative_ui",
  "contract": 2,
  "title": "Illustration Studio",
  "title_key": "app_title",
  "labels": {
    "fallback": "en",
    "en": {
      "app_title": "Illustration Studio",
      "tip_body": "Prompt → SceneGraph → edit in wgpu viewport → beauty via RenderService. Orbit drag · click select · drag move.",
      "compose_section": "Compose",
      "prompt_label": "Prompt",
      "compose_label": "Compose scene",
      "pose_section": "Pose",
      "pose_wave_label": "Wave right",
      "pose_look_label": "Look at box",
      "pose_rest_label": "Rest pose",
      "assets_section": "Assets",
      "project_section": "Project",
      "render_section": "Beauty pass",
      "viewport_label": "Viewport",
      "scene_label": "Scene",
      "scene_empty": "No scene loaded yet. Compose from a prompt, Load project, or add an asset.",
      "save_label": "Save",
      "load_label": "Load",
      "stub_render_label": "Stub beauty",
      "cpu_render_label": "CPU beauty",
      "blender_render_label": "Blender beauty",
      "add_box_label": "Add box",
      "add_humanoid_label": "Add humanoid",
      "add_slim_label": "Add slim",
      "beauty_empty": "No beauty pass yet — run Stub, CPU, or Blender beauty.",
      "preview_label": "Beauty preview"
    },
    "fr": {
      "app_title": "Studio Illustration",
      "tip_body": "Prompt → SceneGraph → édition wgpu → beauté via RenderService. Orbite glisser · clic sélection · glisser déplacer.",
      "compose_section": "Composer",
      "prompt_label": "Invite",
      "compose_label": "Composer la scène",
      "pose_section": "Pose",
      "pose_wave_label": "Saluer (droite)",
      "pose_look_label": "Regarder la boîte",
      "pose_rest_label": "Pose repos",
      "assets_section": "Assets",
      "project_section": "Projet",
      "render_section": "Rendu beauté",
      "viewport_label": "Fenêtre 3D",
      "scene_label": "Scène",
      "scene_empty": "Aucune scène chargée. Composez depuis une invite, chargez un projet, ou ajoutez un asset.",
      "save_label": "Enregistrer",
      "load_label": "Charger",
      "stub_render_label": "Beauté stub",
      "cpu_render_label": "Beauté CPU",
      "blender_render_label": "Beauté Blender",
      "add_box_label": "Ajouter boîte",
      "add_humanoid_label": "Ajouter humanoïde",
      "add_slim_label": "Ajouter mince",
      "beauty_empty": "Pas encore de rendu beauté — lancez Stub, CPU ou Blender.",
      "preview_label": "Aperçu beauté"
    }
  },
  "state": {
    "local": {
      "scene": { "type": "string", "default": "" },
      "selected_id": { "type": "string", "nullable": true, "default": "box" },
      "character_id": { "type": "string", "nullable": true, "default": "humanoid" },
      "prompt": {
        "type": "string",
        "default": "A man enters an old library. He stands by the counter."
      },
      "beauty_path": { "type": "string", "default": "" }
    }
  },
  "bindings": [
    {
      "id": "project",
      "tool": "illustration.project.load",
      "target": "/yaml",
      "invalidate_on": []
    },
    {
      "id": "beauty",
      "tool": "illustration.document.load",
      "target": "/beauty_path",
      "invalidate_on": ["local.beauty_path"]
    }
  ],
  "actions": [
    {
      "id": "save_project",
      "tool": "illustration.project.save",
      "input": { "yaml": "$local.scene" },
      "refresh_binds": ["illustration.project.load"]
    },
    {
      "id": "load_project",
      "tool": "illustration.project.load",
      "input": {},
      "refresh_binds": ["illustration.project.load"]
    },
    {
      "id": "compose_scene",
      "service": "scene.compose",
      "input": {
        "prompt": "$local.prompt"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_wave",
      "service": "scene.pose",
      "input": {
        "preset": "wave_right",
        "humanoid_root": "$local.character_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_look",
      "service": "scene.pose",
      "input": {
        "humanoid_root": "$local.character_id",
        "look_at": { "x": 0.0, "y": 0.8, "z": 0.0 },
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "pose_rest",
      "service": "scene.pose",
      "input": {
        "preset": "rest",
        "humanoid_root": "$local.character_id",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "stub_beauty",
      "service": "render.submit",
      "input": {
        "backend": "stub",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-stub.png",
        "scene_yaml": "$local.scene",
        "r": 48,
        "g": 72,
        "b": 96
      },
      "refresh_binds": []
    },
    {
      "id": "cpu_beauty",
      "service": "render.submit",
      "input": {
        "backend": "cpu",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-cpu.png",
        "scene_yaml": "$local.scene",
        "width": 320,
        "height": 240
      },
      "refresh_binds": []
    },
    {
      "id": "blender_beauty",
      "service": "render.submit",
      "input": {
        "backend": "blender",
        "pass": "beauty",
        "path": "/documents/illustrations/beauty-blender.png",
        "scene_yaml": "$local.scene",
        "width": 256,
        "height": 192
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_box",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "prop.box",
        "parent_id": "root",
        "prefix": "box_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_humanoid",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "humanoid.placeholder",
        "parent_id": "root",
        "prefix": "h_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    },
    {
      "id": "instantiate_slim",
      "service": "asset.instantiate",
      "input": {
        "asset_id": "humanoid.slim",
        "parent_id": "root",
        "prefix": "slim_",
        "scene_yaml": "$local.scene"
      },
      "refresh_binds": []
    }
  ],
  "subscriptions": [],
  "root": {
    "kind": "column",
    "children": [
      {
        "kind": "text",
        "label_key": "tip_body"
      },
      {
        "kind": "text",
        "label_key": "scene_empty",
        "visible": {
          "eq": ["$local.scene", ""]
        }
      },
      {
        "kind": "section",
        "label_key": "compose_section",
        "children": [
          {
            "kind": "text_input",
            "state_key": "prompt",
            "label_key": "prompt_label"
          },
          {
            "kind": "button",
            "label_key": "compose_label",
            "action": "compose_scene",
            "primary": true
          }
        ]
      },
      {
        "kind": "section",
        "label_key": "pose_section",
        "children": [
          {
            "kind": "row",
            "children": [
              {
                "kind": "button",
                "label_key": "pose_wave_label",
                "action": "pose_wave",
                "primary": true
              },
              {
                "kind": "button",
                "label_key": "pose_look_label",
                "action": "pose_look"
              },
              {
                "kind": "button",
                "label_key": "pose_rest_label",
                "action": "pose_rest"
              }
            ]
          }
        ]
      },
      {
        "kind": "section",
        "label_key": "assets_section",
        "children": [
          {
            "kind": "row",
            "children": [
              {
                "kind": "button",
                "label_key": "add_humanoid_label",
                "action": "instantiate_humanoid"
              },
              {
                "kind": "button",
                "label_key": "add_slim_label",
                "action": "instantiate_slim"
              },
              {
                "kind": "button",
                "label_key": "add_box_label",
                "action": "instantiate_box"
              }
            ]
          }
        ]
      },
      {
        "kind": "section",
        "label_key": "render_section",
        "children": [
          {
            "kind": "row",
            "children": [
              {
                "kind": "button",
                "label_key": "cpu_render_label",
                "action": "cpu_beauty",
                "primary": true
              },
              {
                "kind": "button",
                "label_key": "stub_render_label",
                "action": "stub_beauty"
              },
              {
                "kind": "button",
                "label_key": "blender_render_label",
                "action": "blender_beauty"
              }
            ]
          }
        ]
      },
      {
        "kind": "section",
        "label_key": "project_section",
        "children": [
          {
            "kind": "row",
            "children": [
              {
                "kind": "button",
                "label_key": "save_label",
                "action": "save_project"
              },
              {
                "kind": "button",
                "label_key": "load_label",
                "action": "load_project"
              }
            ]
          }
        ]
      },
      {
        "kind": "split",
        "split_ratio": 0.28,
        "children": [
          {
            "kind": "scroll",
            "children": [
              {
                "kind": "scene_tree",
                "scene_key": "scene",
                "selected_key": "selected_id",
                "canvas_id": "illustration_viewport",
                "label_key": "scene_label",
                "empty_label_key": "scene_empty"
              }
            ]
          },
          {
            "kind": "column",
            "children": [
              {
                "kind": "scene3d",
                "scene_key": "scene",
                "selected_key": "selected_id",
                "canvas_id": "illustration_viewport",
                "label_key": "viewport_label",
                "empty_label_key": "scene_empty"
              },
              {
                "kind": "image_view",
                "resource": "$local.beauty_path",
                "label_key": "preview_label",
                "empty_label_key": "beauty_empty"
              }
            ]
          }
        ]
      }
    ]
  }
}
