{
  "$defs": {
    "MemContextRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "k": {
          "default": 5,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "product_k": {
          "default": 0,
          "description": "Top-k product-doc RAG hits (`product:docs`). 0 = default (4).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "query": {
          "type": "string"
        },
        "session_id": {
          "default": null,
          "description": "Session chat active (`session:<id>`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ],
      "title": "MemContextRequest",
      "type": "object"
    },
    "MemContextResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {
        "MemHit": {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "description": "Kind optionnel (`fact` / `episode`).",
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": true,
            "namespace": {
              "type": "string"
            },
            "pinned": {
              "default": false,
              "type": "boolean"
            },
            "relations": {
              "description": "Relations sortantes (1 hop) pour l'UI / bootstrap.",
              "items": {
                "$ref": "#/definitions/MemRelation"
              },
              "type": "array"
            },
            "score": {
              "format": "float",
              "type": "number"
            },
            "superseded": {
              "default": false,
              "description": "True si un autre souvenir `supersedes` celui-ci.",
              "type": "boolean"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "metadata",
            "namespace",
            "score",
            "text"
          ],
          "type": "object"
        },
        "MemRelation": {
          "properties": {
            "from": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "rel": {
              "$ref": "#/definitions/MemRelationKind"
            },
            "to": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "from",
            "rel",
            "to"
          ],
          "type": "object"
        },
        "MemRelationKind": {
          "description": "Relation typée entre souvenirs (E6 / Preview 0.4).",
          "enum": [
            "similar",
            "updates",
            "supersedes"
          ],
          "type": "string"
        }
      },
      "properties": {
        "product_hits": {
          "default": [],
          "description": "Extraíts docs Preview (FEATURES / STATUS / TESTER).",
          "items": {
            "$ref": "#/definitions/MemHit"
          },
          "type": "array"
        },
        "prompt_block": {
          "type": "string"
        },
        "session_hits": {
          "items": {
            "$ref": "#/definitions/MemHit"
          },
          "type": "array"
        },
        "user_hits": {
          "items": {
            "$ref": "#/definitions/MemHit"
          },
          "type": "array"
        }
      },
      "required": [
        "prompt_block",
        "session_hits",
        "user_hits"
      ],
      "title": "MemContextResponse",
      "type": "object"
    },
    "MemEpisodicDeleteRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "`mem.episodic_delete` — par id, ou par namespace + métadonnée (`path`, etc.).",
      "properties": {
        "id": {
          "default": null,
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "meta_key": {
          "default": null,
          "description": "Clé de métadonnée (ex. `\"path\"`) lorsque `id` est absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "meta_value": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "MemEpisodicDeleteRequest",
      "type": "object"
    },
    "MemEpisodicQueryRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "`mem.episodic_query`.",
      "properties": {
        "k": {
          "default": 5,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "namespace": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "MemEpisodicQueryRequest",
      "type": "object"
    },
    "MemEpisodicWriteRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "`mem.episodic_write`.",
      "properties": {
        "auto_link": {
          "default": false,
          "description": "Si true, auto-crée `updates`/`supersedes` vers un hit proche du même namespace.",
          "type": "boolean"
        },
        "auto_link_threshold": {
          "default": 0.8199999928474426,
          "format": "float",
          "type": "number"
        },
        "kind": {
          "default": null,
          "description": "Kind optionnel : `fact` ou `episode`.",
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "default": null
        },
        "namespace": {
          "description": "Namespace (`agent:<id>`, `module:<nom>`).",
          "type": "string"
        },
        "pinned": {
          "default": false,
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "text"
      ],
      "title": "MemEpisodicWriteRequest",
      "type": "object"
    },
    "MemExtractOutcome": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {
        "MemExtractOutcomeKind": {
          "description": "Issue pour un candidat (stocké, skip dédup, ou filtré secret).",
          "oneOf": [
            {
              "enum": [
                "stored",
                "skipped_duplicate",
                "filtered_secret",
                "skipped_empty"
              ],
              "type": "string"
            },
            {
              "description": "One-shot canvas / draw / completion task — not a durable user fact.",
              "enum": [
                "filtered_ephemeral"
              ],
              "type": "string"
            },
            {
              "description": "Tool trace, agent action log, or delegation prose — not a human fact.",
              "enum": [
                "filtered_trace"
              ],
              "type": "string"
            }
          ]
        },
        "MemRelation": {
          "properties": {
            "from": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "rel": {
              "$ref": "#/definitions/MemRelationKind"
            },
            "to": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "from",
            "rel",
            "to"
          ],
          "type": "object"
        },
        "MemRelationKind": {
          "description": "Relation typée entre souvenirs (E6 / Preview 0.4).",
          "enum": [
            "similar",
            "updates",
            "supersedes"
          ],
          "type": "string"
        }
      },
      "properties": {
        "auto_relations": {
          "items": {
            "$ref": "#/definitions/MemRelation"
          },
          "type": "array"
        },
        "id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/MemExtractOutcomeKind"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
