{
  "$defs": {
    "SecretGetRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "`secrets.get` — usage restreint aux services (jamais aux agents, §9.2). L'identité fait foi via `Intent.from` (bus) ; `actor` est ignoré s'il diverge.",
      "properties": {
        "actor": {
          "default": "",
          "description": "Déprécié : conservé pour compat ; le daemon utilise `Intent.from`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "SecretGetRequest",
      "type": "object"
    },
    "SecretListRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "`secrets.list` — noms uniquement.",
      "title": "SecretListRequest",
      "type": "object"
    },
    "SecretListResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "encrypted": {
          "type": "boolean"
        },
        "names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "encrypted",
        "names"
      ],
      "title": "SecretListResponse",
      "type": "object"
    },
    "SecretSetRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "`secrets.set` — écriture depuis UI Settings / services.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "description": "Valeur vide = suppression.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SecretSetRequest",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "JSON Schema (draft-07) for secrets.* bus payloads. Raw values are for OS services only (F-SEC-04); never for agents. Canonical wire format remains CBOR.",
  "title": "Akasha OS aos-proto secrets intents",
  "version": "0.6.0"
}
